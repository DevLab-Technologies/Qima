<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Live prices. Flutter only adds INTERNET to debug and profile builds,
         so release builds need it declared here. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- App lock (spec Phase 4): biometric authentication via local_auth. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Price alerts (spec Phase 5): posting notifications (Android 13+
         requires this permission and an explicit runtime request — see
         NotificationService.requestPermission) and running the periodic
         background refresh/evaluation task via WorkManager. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Dictation in Add (v4): on-device speech recognition only. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Bank text messages (v5): read only after the person turns them on
         in Qima; see BankSms.kt. Google Play needs the SMS permissions
         declaration (SMS-based money management) before release. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <application
        android:label="Qima"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <receiver android:name=".BankSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <!-- Home-screen widgets (Jetpack Glance). Data is written by
             lib/services/home_widget_service.dart via the `home_widget`
             plugin; these receivers only render it. Each widget is
             per-instance configurable (android:configure below), same as
             iOS's App Intent pickers; see widget/WidgetConfigStore.kt. -->
        <receiver android:name=".widget.PriceGlanceReceiver"
            android:exported="true"
            android:label="@string/price_widget_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/price_glance_widget_info" />
        </receiver>

        <activity android:name=".widget.PriceConfigActivity"
            android:exported="true"
            android:theme="@style/NormalTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver android:name=".widget.PortfolioGlanceReceiver"
            android:exported="true"
            android:label="@string/portfolio_widget_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/portfolio_glance_widget_info" />
        </receiver>

        <activity android:name=".widget.PortfolioConfigActivity"
            android:exported="true"
            android:theme="@style/NormalTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Read-only answers for the system assistant on Android 16+ (v4
             phase 5). The class and the XML are generated from
             AssistantFunctions.kt. -->
        <service android:name=".QimaAssistantService"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            android:exported="true">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="qima_assistant.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
