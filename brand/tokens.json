  },
  "fontFamily": {
    "appLatin": {
      "$value": "system-ui",
      "$description": "Platform font in the app: SF Pro on Apple, Roboto on Android"
    },
    "appArabic": {
      "$value": "Almarai",
      "$description": "Arabic in the app, bundled (SIL OFL 1.1)"
    },
    "marketing": {
      "$value": "Almarai",
      "$description": "Store art, website, social, email; both scripts"
    },
    "wordmark": {
      "$value": "Almarai Bold 700, letter-spacing -0.01em, outlined"
    }
  },
  "space": {
    "3xs": {
      "$type": "dimension",
      "$value": "2px"
    },
    "2xs": {
      "$type": "dimension",
      "$value": "4px"
    },
    "xs": {
      "$type": "dimension",
      "$value": "6px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "10px"
    },
    "md": {
      "$type": "dimension",
      "$value": "16px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "20px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "28px"
    }
  },
  "radius": {
    "xs": {
      "$type": "dimension",
      "$value": "6px"
    },
    "tile": {
      "$type": "dimension",
      "$value": "14px"
    },
    "card": {
      "$type": "dimension",
      "$value": "22px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "100px"
    }
  },
  "elevation": {
    "e0": {
      "use": "Tiles inside cards",
      "shadows": []
    },
    "e1": {
      "use": "Cards",
      "shadows": [
        {
          "color": "shadow",
          "blur": 10,
          "y": 3
        }
      ]
    },
    "e2": {
      "use": "Hero cards (portfolio, zakat due)",
      "shadows": [
        {
          "color": "accent@0.10",
          "blur": 20,
          "y": 6
        },
        {
          "color": "shadow",
          "blur": 10,
          "y": 3
        }
      ]
    },
    "e3": {
      "use": "Menus, dialogs, sheets",
      "shadows": [
        {
          "color": "shadow",
          "blur": 24,
          "y": 8
        }
      ]
    }
  },
  "motion": {
    "duration": {
      "instant": {
        "$type": "duration",
        "$value": "0ms"
      },
      "quick": {
        "$type": "duration",
        "$value": "150ms"
      },
      "standard": {
        "$type": "duration",
        "$value": "250ms"
      },
      "emphasized": {
        "$type": "duration",
        "$value": "300ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.22,
          0.61,
          0.36,
          1.0
        ]
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": [
          0.55,
          0.06,
          0.68,
          0.19
        ]
      }
    },
    "reducedMotion": {
      "$description": "When the OS asks for reduced motion, movement becomes instant; opacity and colour changes keep the quick duration."
    }
  },
  "size": {
    "touchTargetIOS": {
      "$type": "dimension",
      "$value": "44px"
    },
    "touchTargetAndroid": {
      "$type": "dimension",
      "$value": "48px"
    },
    "iconSm": {
      "$type": "dimension",
      "$value": "16px"
    },
    "iconMd": {
      "$type": "dimension",
      "$value": "20px"
    },
    "iconLg": {
      "$type": "dimension",
      "$value": "24px"
    },
    "focusRing": {
      "$type": "dimension",
      "$value": "2px"
    },
    "selectedBorder": {
      "$type": "dimension",
      "$value": "1.5px"
    }
  }
}
