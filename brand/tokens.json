{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Qima design tokens. Generated by brand/tool/build_brand.py; edit the script, not this file.",
  "color": {
    "bg0": {
      "$type": "color",
      "$description": "Screen background, bottom of the screen gradient",
      "$value": {
        "light": "#ECEEF2",
        "dark": "#08090C"
      }
    },
    "bg1": {
      "$type": "color",
      "$description": "Screen background top, navigation bar",
      "$value": {
        "light": "#F7F8FA",
        "dark": "#0F1116"
      }
    },
    "surfaceTop": {
      "$type": "color",
      "$description": "Card fill, top of gradient",
      "$value": {
        "light": "#FFFFFF",
        "dark": "#1F2229"
      }
    },
    "surfaceBottom": {
      "$type": "color",
      "$description": "Card fill, bottom of gradient",
      "$value": {
        "light": "#FAFAFC",
        "dark": "#191B21"
      }
    },
    "tileTop": {
      "$type": "color",
      "$description": "Inset tile, chip and segment track",
      "$value": {
        "light": "#F2F3F6",
        "dark": "#2B2F39"
      }
    },
    "tileBottom": {
      "$type": "color",
      "$description": "Inset tile gradient end",
      "$value": {
        "light": "#EAECF0",
        "dark": "#22252D"
      }
    },
    "segmentThumb": {
      "$type": "color",
      "$description": "Selected segment of a segmented control",
      "$value": {
        "light": "#FFFFFF",
        "dark": "#454A56"
      }
    },
    "overlay": {
      "$type": "color",
      "$description": "Menus, dialogs, sheets",
      "$value": {
        "light": "#FFFFFF",
        "dark": "#262A33"
      }
    },
    "hairline": {
      "$type": "color",
      "$description": "Card borders, dividers (decorative)",
      "$value": {
        "light": "rgba(17, 19, 24, 0.1)",
        "dark": "rgba(255, 255, 255, 0.1)"
      }
    },
    "hairlineStrong": {
      "$type": "color",
      "$description": "Outlined button borders (decorative; the label carries meaning)",
      "$value": {
        "light": "rgba(17, 19, 24, 0.18)",
        "dark": "rgba(255, 255, 255, 0.18)"
      }
    },
    "textPrimary": {
      "$type": "color",
      "$description": "Headings, body text, figures",
      "$value": {
        "light": "#111318",
        "dark": "#FFFFFF"
      }
    },
    "textSecondary": {
      "$type": "color",
      "$description": "Supporting text, row subtitles (changed: more distinct from tertiary)",
      "$value": {
        "light": "rgba(17, 19, 24, 0.76)",
        "dark": "rgba(255, 255, 255, 0.68)"
      }
    },
    "textTertiary": {
      "$type": "color",
      "$description": "Captions, timestamps, unselected tab labels",
      "$value": {
        "light": "rgba(17, 19, 24, 0.6)",
        "dark": "rgba(255, 255, 255, 0.52)"
      }
    },
    "up": {
      "$type": "color",
      "$description": "Price or value went up",
      "$value": {
        "light": "#166B2E",
        "dark": "#3DBE6E"
      }
    },
    "down": {
      "$type": "color",
      "$description": "Price or value went down",
      "$value": {
        "light": "#B42A26",
        "dark": "#FF6B61"
      }
    },
    "brand": {
      "$type": "color",
      "$description": "Gold fill: the one primary button per screen, brand moments. Never text.",
      "$value": {
        "light": "#D4A72C",
        "dark": "#E6BA4D"
      }
    },
    "brandText": {
      "$type": "color",
      "$description": "Gold text and icons: text buttons, links, selected tab",
      "$value": {
        "light": "#8A6410",
        "dark": "#E6BA4D"
      }
    },
    "brandIndicator": {
      "$type": "color",
      "$description": "Gold UI marks that must reach 3:1: selected-chip border, switch track, focus ring (new)",
      "$value": {
        "light": "#A87B14",
        "dark": "#E6BA4D"
      }
    },
    "onBrand": {
      "$type": "color",
      "$description": "Text and icons on a brand fill",
      "$value": {
        "light": "#1A1406",
        "dark": "#08090C"
      }
    },
    "success": {
      "$type": "color",
      "$description": "Done, saved, restored (same values as up)",
      "$value": {
        "light": "#166B2E",
        "dark": "#3DBE6E"
      }
    },
    "warning": {
      "$type": "color",
      "$description": "Needs attention, not broken (new)",
      "$value": {
        "light": "#9A4D00",
        "dark": "#F5A524"
      }
    },
    "error": {
      "$type": "color",
      "$description": "Failed or invalid (same values as down)",
      "$value": {
        "light": "#B42A26",
        "dark": "#FF6B61"
      }
    },
    "info": {
      "$type": "color",
      "$description": "Neutral notices (new)",
      "$value": {
        "light": "#1F62C9",
        "dark": "#6EA8FF"
      }
    },
    "shadow": {
      "$type": "color",
      "$description": "Card shadow",
      "$value": {
        "light": "rgba(27, 34, 48, 0.08)",
        "dark": "rgba(0, 0, 0, 0.45)"
      }
    },
    "scrim": {
      "$type": "color",
      "$description": "Behind modal sheets and dialogs",
      "$value": {
        "light": "rgba(17, 19, 24, 0.32)",
        "dark": "rgba(0, 0, 0, 0.55)"
      }
    },
    "accentGold": {
      "$type": "color",
      "$description": "Gold instrument tint (changed in light: now equals brandIndicator)",
      "$value": {
        "light": "#A87B14",
        "dark": "#E6BA4D"
      }
    },
    "accentSilver": {
      "$type": "color",
      "$description": "Silver instrument tint (changed in light)",
      "$value": {
        "light": "#7A7D83",
        "dark": "rgba(199, 199, 199, 0.78)"
      }
    },
    "accentPlatinum": {
      "$type": "color",
      "$description": "Platinum and palladium tint (changed in light)",
      "$value": {
        "light": "#5A7FA5",
        "dark": "#A9C4DD"
      }
    },
    "accentCrypto": {
      "$type": "color",
      "$description": "Crypto tint (changed in light)",
      "$value": {
        "light": "#C2620F",
        "dark": "#F28C33"
      }
    },
    "accentFiat": {
      "$type": "color",
      "$description": "Currency tint (changed in light)",
      "$value": {
        "light": "#10808F",
        "dark": "#3FB8C9"
      }
    },
    "accentStock": {
      "$type": "color",
      "$description": "Stock tint",
      "$value": {
        "light": "#4A6FDB",
        "dark": "#6B8CEB"
      }
    },
    "accentIndex": {
      "$type": "color",
      "$description": "Index tint",
      "$value": {
        "light": "#7447C9",
        "dark": "#9975E0"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$description": "The asset price on the detail screen",
      "$value": {
        "latin": {
          "fontFamily": "system-ui (SF Pro / Roboto)",
          "fontSize": 40,
          "lineHeight": 44,
          "fontWeight": 700,
          "letterSpacing": -0.5,
          "fontFeatures": [
            "tnum"
          ]
        },
        "arabic": {
          "fontFamily": "Almarai",
          "fontSize": 40,
          "lineHeight": 50,
          "fontWeight": 800,
          "letterSpacing": 0,
          "fontFeatures": [
            "tnum"
          ]
        }
      }
    },
    "hero": {
      "$type": "typography",
      "$description": "Portfolio and zakat totals on hero cards",
      "$value": {
        "latin": {
          "fontFamily": "system-ui (SF Pro / Roboto)",
          "fontSize": 30,
          "lineHeight": 36,
          "fontWeight": 700,
          "letterSpacing": -0.3,
          "fontFeatures": [
            "tnum"
          ]
        },
        "arabic": {
          "fontFamily": "Almarai",
          "fontSize": 30,
          "lineHeight": 40,
          "fontWeight": 800,
          "letterSpacing": 0,
          "fontFeatures": [
            "tnum"
          ]
        }
      }
    },
    "title1": {
      "$type": "typography",
      "$description": "Large screen titles, sheet titles",
      "$value": {
        "latin": {
          "fontFamily": "system-ui (SF Pro / Roboto)",
          "fontSize": 22,
          "lineHeight": 28,
          "fontWeight": 700,
          "letterSpacing": 0,
          "fontFeatures": [
            "tnum"
          ]
        },
        "arabic": {
          "fontFamily": "Almarai",
          "fontSize": 22,
          "lineHeight": 32,
          "fontWeight": 800,
          "letterSpacing": 0,
          "fontFeatures": [
            "tnum"
          ]
        }
      }
    },
    "title2": {
      "$type": "typography",
      "$description": "Card titles, navigation bar titles, row prices",
      "$value": {
        "latin": {
          "fontFamily": "system-ui (SF Pro / Roboto)",
          "fontSize": 17,
          "lineHeight": 22,
          "fontWeight": 600,
          "letterSpacing": 0,
          "fontFeatures": [
            "tnum"
          ]
        },
        "arabic": {
          "fontFamily": "Almarai",
          "fontSize": 17,
          "lineHeight": 26,
          "fontWeight": 700,
          "letterSpacing": 0,
          "fontFeatures": [
            "tnum"
          ]
        }
      }
    },
    "bodyLarge": {
      "$type": "typography",
      "$description": "Paragraphs, form fields, onboarding body",
      "$value": {
        "latin": {
          "fontFamily": "system-ui (SF Pro / Roboto)",
          "fontSize": 16,
          "lineHeight": 22,
          "fontWeight": 400,
          "letterSpacing": 0,
          "fontFeatures": [
            "tnum"
          ]
        },
        "arabic": {
          "fontFamily": "Almarai",
          "fontSize": 16,
          "lineHeight": 26,
          "fontWeight": 400,
          "letterSpacing": 0,
          "fontFeatures": [
            "tnum"
          ]
        }
      }
    },
    "rowTitle": {
      "$type": "typography",
      "$description": "Watchlist and holdings row names, button labels",
      "$value": {
        "latin": {
          "fontFamily": "system-ui (SF Pro / Roboto)",
          "fontSize": 15,
