      "$type": "typography",
      "$description": "Section headers and metric labels",
      "$value": {
        "latin": {
          "fontFamily": "system-ui (SF Pro / Roboto)",
          "fontSize": 12,
          "lineHeight": 16,
          "fontWeight": 600,
          "letterSpacing": 0.5,
          "fontFeatures": [
