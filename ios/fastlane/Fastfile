require "base64"
require "securerandom"
require "fileutils"
require "shellwords"

default_platform(:ios)

APP_IDENTIFIER = "com.devlabtechnologies.qima"
WIDGET_IDENTIFIER = "com.devlabtechnologies.qima.widget"
WIDGET_TARGET = "QimaWidgetExtension"
MAC_PROJECT = "../macos/Runner.xcodeproj"
MAC_INSTALLER_IDENTITY = "3rd Party Mac Developer Installer"
APPLE_TEAM_ID = "ZS3A435WC2"
# fastlane's working directory is not guaranteed to be the repo root, so
# anchor every path to it explicitly. __dir__ here is ios/fastlane.
REPO_ROOT = File.expand_path("../..", __dir__)

# Loads the App Store Connect API key from ASC_KEY_ID / ASC_ISSUER_ID /
# ASC_KEY_CONTENT (base64-encoded .p8 contents). This is the only supported
# auth path here - no Apple ID/password, so nothing breaks on a 2FA prompt in CI.
def require_asc_api_key!
  key_id = ENV["ASC_KEY_ID"]
  issuer_id = ENV["ASC_ISSUER_ID"]
  key_content = ENV["ASC_KEY_CONTENT"]

  unless key_id && issuer_id && key_content
    UI.user_error!(
      "ASC_KEY_ID, ASC_ISSUER_ID and ASC_KEY_CONTENT must all be set " \
      "(App Store Connect API key). See README/PR description for how to " \
      "generate one in App Store Connect > Users and Access > Integrations."
    )
  end

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_content: key_content,
    is_key_content_base64: true,
    in_house: false
  )
end

# Installs a base64-encoded provisioning profile where Xcode looks for
# profiles (both the legacy and the Xcode 16+ folder) and returns its Name,
# which the signing settings and export options use. iOS profiles end in
# .mobileprovision, macOS ones in .provisionprofile.
def install_profile!(base64_content, extension: "mobileprovision")
  profile_path = File.expand_path("profile.#{extension}", Dir.pwd)
  File.binwrite(profile_path, Base64.decode64(base64_content))
  begin
    plist_xml = Actions.sh("security cms -D -i #{profile_path.shellescape}", log: false)
    uuid = plist_xml[/<key>UUID<\/key>\s*<string>(.*?)<\/string>/m, 1]
    profile_name = plist_xml[/<key>Name<\/key>\s*<string>(.*?)<\/string>/m, 1]
    UI.user_error!("Could not read UUID/Name from the provisioning profile.") unless uuid && profile_name

    ["~/Library/MobileDevice/Provisioning Profiles", "~/Library/Developer/Xcode/UserData/Provisioning Profiles"].each do |dir|
      profiles_dir = File.expand_path(dir)
      FileUtils.mkdir_p(profiles_dir)
      FileUtils.cp(profile_path, File.join(profiles_dir, "#{uuid}.#{extension}"))
    end
  ensure
    File.delete(profile_path) if File.exist?(profile_path)
  end
  profile_name
end

# Archives the macOS app and exports it as an installer package signed for
# the Mac App Store; returns the .pkg path. Flutter has no `build pkg`, so
# this is `flutter build macos --config-only` (version, build number, pods)
# followed by a plain Xcode archive and export.
def build_mac_pkg!(build_number, profile_name)
  archive_path = File.join(REPO_ROOT, "build/macos/Qima.xcarchive")
  export_path = File.join(REPO_ROOT, "build/macos/pkg")
  options_path = File.join(REPO_ROOT, "build/macos/ExportOptions.plist")
  FileUtils.mkdir_p(File.dirname(options_path))
  File.write(options_path, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>method</key>
      <string>app-store-connect</string>
      <key>teamID</key>
      <string>#{APPLE_TEAM_ID}</string>
      <key>signingStyle</key>
      <string>manual</string>
      <key>signingCertificate</key>
      <string>Apple Distribution</string>
      <key>installerSigningCertificate</key>
      <string>#{MAC_INSTALLER_IDENTITY}</string>
      <key>provisioningProfiles</key>
      <dict>
        <key>#{APP_IDENTIFIER}</key>
        <string>#{profile_name}</string>
      </dict>
      <key>uploadSymbols</key>
      <true/>
    </dict>
    </plist>
  PLIST

  Dir.chdir(REPO_ROOT) do
    Actions.sh("flutter", "build", "macos", "--config-only", "--release", "--build-number=#{build_number}")
    Actions.sh(
      "xcodebuild", "-workspace", "macos/Runner.xcworkspace", "-scheme", "Runner",
      "-configuration", "Release", "-archivePath", archive_path, "archive"
    )
    FileUtils.rm_rf(export_path)
    Actions.sh(
      "xcodebuild", "-exportArchive", "-archivePath", archive_path,
      "-exportPath", export_path, "-exportOptionsPlist", options_path
    )
  end

  pkg_path = Dir.glob(File.join(export_path, "*.pkg")).first
  UI.user_error!("No .pkg found under #{export_path} after the export.") unless pkg_path
  pkg_path
end

# Writes an ExportOptions.plist for a manual-signing app-store export. Not
# checked into git because the profile names come from secrets at build time.
def write_export_options!(profile_name, widget_profile_name)
  path = File.expand_path("../ExportOptions.plist", __dir__)
  File.write(path, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>method</key>
      <string>app-store-connect</string>
      <key>teamID</key>
      <string>#{APPLE_TEAM_ID}</string>
      <key>signingStyle</key>
      <string>manual</string>
      <key>signingCertificate</key>
      <string>Apple Distribution</string>
      <key>provisioningProfiles</key>
      <dict>
        <key>#{APP_IDENTIFIER}</key>
        <string>#{profile_name}</string>
        <key>#{WIDGET_IDENTIFIER}</key>
        <string>#{widget_profile_name}</string>
      </dict>
      <key>uploadBitcode</key>
      <false/>
      <key>uploadSymbols</key>
      <true/>
    </dict>
    </plist>
  PLIST
  path
end

desc "Create a throwaway, unlocked CI keychain on the search list. Returns its name and password."
private_lane :ci_keychain do
  keychain = { name: "qima-ci.keychain-db", password: SecureRandom.hex(16) }
  create_keychain(
    name: keychain[:name],
    password: keychain[:password],
    default_keychain: false,
    unlock: true,
    timeout: 3600
  )
  keychain
end

desc "Import a base64-encoded .p12 into the CI keychain."
private_lane :import_p12 do |options|
  keychain = options[:keychain]
  cert_path = File.expand_path("cert.p12", Dir.pwd)
  File.binwrite(cert_path, Base64.decode64(options[:base64]))
  begin
    import_certificate(
      certificate_path: cert_path,
      certificate_password: options[:password] || "",
      keychain_name: keychain[:name],
      keychain_password: keychain[:password]
    )
  ensure
    File.delete(cert_path) if File.exist?(cert_path)
  end
end

platform :ios do
  desc "Read-only: confirm the App Store Connect API key authenticates and report whether the app record already exists."
  lane :preflight do
    require_asc_api_key!
    UI.success("App Store Connect API key accepted for issuer #{ENV['ASC_ISSUER_ID']}.")

    begin
      existing = Spaceship::ConnectAPI::App.get_apps(filter: { bundleId: APP_IDENTIFIER })
      if existing && !existing.empty?
        UI.important("An app already exists in App Store Connect for #{APP_IDENTIFIER} (id=#{existing.first.id}). Nothing to create.")
      else
        UI.message("No app record yet for #{APP_IDENTIFIER}. Create it in App Store Connect > Apps > New App - the App Store Connect API cannot create app records.")
      end
    rescue => e
      UI.user_error!("Authenticated, but listing apps failed: #{e.message}")
    end
  end

  desc "Import a distribution certificate (.p12) and the app and widget provisioning profiles (.mobileprovision) from base64 secrets into a throwaway CI keychain, then switch Runner and the widget extension to manual signing."
  lane :setup_signing do
    keychain = ci_keychain
    import_p12(keychain: keychain, base64: ENV.fetch("IOS_DIST_CERT_BASE64"), password: ENV.fetch("IOS_DIST_CERT_PASSWORD", ""))

    profile_name = install_profile!(ENV.fetch("IOS_PROVISION_PROFILE_BASE64"))
    widget_profile_name = install_profile!(ENV.fetch("IOS_WIDGET_PROVISION_PROFILE_BASE64"))

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: APPLE_TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["Runner"]
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: APPLE_TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: widget_profile_name,
      targets: [WIDGET_TARGET]
    )

    Actions.lane_context[:QIMA_PROFILE_NAME] = profile_name
    Actions.lane_context[:QIMA_WIDGET_PROFILE_NAME] = widget_profile_name
  end

  desc "Build the release IPA and upload it to TestFlight. Requires QIMA_BUILD_NUMBER (CI passes github.run_number, or latest_testflight_build_number + 1)."
  lane :beta do
    build_number = ENV["QIMA_BUILD_NUMBER"]
    UI.user_error!("QIMA_BUILD_NUMBER must be set - build numbers must strictly increase per TestFlight upload.") unless build_number

    api_key = require_asc_api_key!
    setup_signing
    export_options_path = write_export_options!(
      Actions.lane_context[:QIMA_PROFILE_NAME],
      Actions.lane_context[:QIMA_WIDGET_PROFILE_NAME]
    )

    Dir.chdir(REPO_ROOT) do
      sh(
        "flutter", "build", "ipa",
        "--release",
        "--build-number=#{build_number}",
        "--export-options-plist=#{export_options_path}"
      )
    end

    ipa_path = Dir.glob(File.join(REPO_ROOT, "build/ios/ipa/*.ipa")).first
    UI.user_error!("No .ipa found under build/ios/ipa after flutter build ipa.") unless ipa_path

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )

    UI.success("Uploaded build #{build_number} to TestFlight.")
  end

  desc "Build and code-sign the release IPA WITHOUT uploading. Used for workflow_dispatch validation runs so a broken secret fails privately, not on a public tag."
  lane :build_only do
    build_number = ENV["QIMA_BUILD_NUMBER"] || "0"
    setup_signing
    export_options_path = write_export_options!(
      Actions.lane_context[:QIMA_PROFILE_NAME],
      Actions.lane_context[:QIMA_WIDGET_PROFILE_NAME]
    )

    Dir.chdir(REPO_ROOT) do
      sh(
        "flutter", "build", "ipa",
        "--release",
        "--build-number=#{build_number}",
        "--export-options-plist=#{export_options_path}"
      )
    end

    UI.success("Built and signed the release IPA without uploading (build_only lane).")
  end

  desc "Upload the App Store listing (text from fastlane/metadata, screenshots from fastlane/screenshots) for the pubspec version. Never uploads a binary and never submits for review."
  lane :metadata do
    api_key = require_asc_api_key!
    pubspec = File.read(File.expand_path("../../pubspec.yaml", __dir__))
    app_version = pubspec[/^version:\s*([0-9.]+)/, 1]
    UI.user_error!("Could not read the version from pubspec.yaml.") unless app_version

    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: app_version,
      metadata_path: File.expand_path("metadata", __dir__),
      screenshots_path: File.expand_path("screenshots", __dir__),
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true
    )

    UI.success("Uploaded the App Store listing for #{app_version}. Submit for review in App Store Connect.")
  end
end

platform :mac do
  desc "Import the distribution and Mac installer certificates and the Mac App Store profile into a throwaway CI keychain, then switch the macOS Runner to manual signing."
  lane :setup_signing do
    keychain = ci_keychain
    # "Apple Distribution" signs Mac apps as well as iOS ones.
    import_p12(keychain: keychain, base64: ENV.fetch("IOS_DIST_CERT_BASE64"), password: ENV.fetch("IOS_DIST_CERT_PASSWORD", ""))
    import_p12(keychain: keychain, base64: ENV.fetch("MAC_INSTALLER_CERT_BASE64"), password: ENV.fetch("MAC_INSTALLER_CERT_PASSWORD", ""))

    profile_name = install_profile!(ENV.fetch("MACOS_PROVISION_PROFILE_BASE64"), extension: "provisionprofile")
    update_code_signing_settings(
      use_automatic_signing: false,
      path: MAC_PROJECT,
      team_id: APPLE_TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["Runner"]
    )
    # iCloud sync needs the key-value store entitlement, which only a build
    # signed with the Mac App Store profile may carry; the direct-download
    # zip (release.yml) keeps Release.entitlements without it.
    project = Xcodeproj::Project.open(File.expand_path(MAC_PROJECT, Dir.pwd))
    runner = project.targets.find { |target| target.name == "Runner" }
    runner.build_configurations.find { |config| config.name == "Release" }
          .build_settings["CODE_SIGN_ENTITLEMENTS"] = "Runner/AppStore.entitlements"
    project.save

    Actions.lane_context[:QIMA_MAC_PROFILE_NAME] = profile_name
  end

  desc "Build the signed Mac App Store installer package and upload it to TestFlight. Requires QIMA_BUILD_NUMBER."
  lane :beta do
    build_number = ENV["QIMA_BUILD_NUMBER"]
    UI.user_error!("QIMA_BUILD_NUMBER must be set - build numbers must strictly increase per TestFlight upload.") unless build_number

    api_key = require_asc_api_key!
    setup_signing
    pkg_path = build_mac_pkg!(build_number, Actions.lane_context[:QIMA_MAC_PROFILE_NAME])

    upload_to_testflight(
      api_key: api_key,
      pkg: pkg_path,
      app_platform: "osx",
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )

    UI.success("Uploaded macOS build #{build_number} to TestFlight.")
  end

  desc "Build and sign the Mac App Store installer package WITHOUT uploading, for workflow_dispatch validation runs."
  lane :build_only do
    setup_signing
    build_mac_pkg!(ENV["QIMA_BUILD_NUMBER"] || "0", Actions.lane_context[:QIMA_MAC_PROFILE_NAME])
    UI.success("Built and signed the macOS installer package without uploading (build_only lane).")
  end
end
